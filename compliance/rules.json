{
  "version": "seed-0.1",
  "note": "Seed rules are TRIGGERS for the KB-first review, not the assessment: a match makes --llm mode query the knowledge graph (kb.query --search/--unit) for the obligations relevant to the artifact and assess applicability against them. Line-scoped matching: every term in a pattern group is a case-insensitive regex that must match within the same line. A rule fires if any of its pattern groups matches. Citations are verifiable against the KB graph (kb/graph.py node ids, e.g. article-5) once the kb/ layer is in the worktree.",
  "rules": [
    {
      "id": "SOC-01",
      "type": "pattern",
      "severity": "block",
      "title": "Social scoring of people with detrimental treatment",
      "citations": ["Art. 5(1)(c)"],
      "stage": ["planning", "implementation", "documentation"],
      "patterns": [
        {"all": ["scor(e|ing|es)", "access", "restrict|suspend|ban|limit|deny|revoke"]},
        {"all": ["scor(e|ing|es)", "reliability|trustworthiness|creditworthiness", "account|user|person|applicant"]},
        {"all": ["rank(s|ing)? (user|person|customer)", "restrict|suspend|ban|limit|deny"]},
        {"all": ["scor(e|ing|es)", "suspend|restrict|ban|revoke|deny|block access|deactivate"]},
        {"file_scope": true, "all": ["(scor\\w*|trust\\w*)\\w*\\s*[(:=]|score\\s*[=+]", "restrict(ion|ed|ions|s)?\\b", "\\bthreshold\\b|below (a |the )?threshold|RESTRICT_BELOW|RESTRICTION_THRESHOLD"]}
      ]
    },
    {
      "id": "EMO-01",
      "type": "pattern",
      "severity": "block",
      "title": "Emotion recognition in workplace or education",
      "citations": ["Art. 5(1)(f)"],
      "stage": ["planning", "implementation", "documentation"],
      "patterns": [
        {"all": ["emotion", "workplace|workplace-related|employee|staff|office|employer"]},
        {"all": ["emotion", "education|student|school|classroom|exam"]},
        {"all": ["infer|detect|detecting|recognis|recogniz", "emotion(al)? state", "employee|staff|student"]},
        {"file_scope": true, "all": ["emotion\\w*", "employee|staff|workplace"]}
      ]
    },
    {
      "id": "FRB-01",
      "type": "pattern",
      "severity": "block",
      "title": "Untargeted scraping of facial images for facial recognition databases",
      "citations": ["Art. 5(1)(e)"],
      "stage": ["planning", "implementation", "documentation"],
      "patterns": [
        {"all": ["scrape|scraping|crawl|crawling|harvest|harvesting|collect", "facial image|face image|face image(s)?|faces from", "database|recognition"]}
      ]
    },
    {
      "id": "MANIP-01",
      "type": "pattern",
      "severity": "warn",
      "title": "Manipulative-technique pattern (guaranteed results + urgency pressure)",
      "citations": ["Art. 5(1)(a)", "Art. 5(1)(b)"],
      "stage": ["planning", "implementation", "documentation"],
      "patterns": [
        {"all": ["guarantee(d|s)?|cannot fail|risk.?free|100% (success|accuracy)", "result(s)?|outcome(s)?|accuracy"]},
        {"all": ["act now|act immediately|limited time|last chance|don.?t miss", "purchase|buy|subscribe|sign up|convert"]}
      ]
    },
    {
      "id": "DISC-01",
      "type": "disclosure",
      "severity": "warn",
      "title": "AI interaction without disclosure (transparency obligation)",
      "citations": ["Art. 50(1)", "Art. 50(2)"],
      "stage": ["implementation"],
      "applies_globs": ["**/ui/**", "**/component(s)?/**", "**/frontend/**", "**/web/**", "**/chat/**", "prompts/**"],
      "mention": ["\\bAI\\b", "\\bagent\\b", "assistant", "chatbot", "chat bot"],
      "required": ["automated (system|decision)|you are (interacting|talking|speaking) (with|to)|AI (assistant|system) disclosure|generated by (an )?AI|interacting with (an )?AI"]
    }
  ]
}
